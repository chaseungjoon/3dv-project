     ctypes.CDLL(lib_path)
 
 # See Note [Global dependencies]
+# [sm_120 local build] Preload the CUDA 12.8 NVRTC this wheel was built against. ATen's lazy
+# dlopen("libnvrtc.so.12") ignores RUNPATH and would otherwise pick an older system copy
+# (Ubuntu's CUDA 12.0), which rejects --gpu-architecture=sm_120 in jiterator kernels.
+if sys.platform == "linux":
+    for _lib in ("libnvrtc-builtins.so.12.8", "libnvrtc.so.12"):
+        try:
+            ctypes.CDLL("/home/chaseungjoon/code/3dv-project/isaacgym-env/.toolchain/cuda-12.8/lib64/" + _lib, mode=ctypes.RTLD_GLOBAL)
+        except OSError:
+            pass
+
+
